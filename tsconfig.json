{
    "compilerOptions": {
        "target": "ES2022",
        "lib": [
            "ES2024",
            "DOM",
            "DOM.Iterable"
        ],
        "module": "ESNext",
        "moduleResolution": "bundler",
        "jsx": "react-jsx",
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "noImplicitOverride": true,
        "noFallthroughCasesInSwitch": true,
        "skipLibCheck": true,
        "isolatedModules": true,
        "verbatimModuleSyntax": true,
        "noEmit": true,
        "types": [
            "vite/client"
        ],
        "paths": {
            "#/*": [
                "./src/*"
            ]
        }
    },
    "include": [
        "src"
    ],
    "exclude": [
        "src/vendor"
    ],
    "references": [
        {
            "path": "./tsconfig.vendor.json"
        }
    ]
}
